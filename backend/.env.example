# Server Port & Environment
PORT=5000
FLASK_ENV=production

# Application & Token Security Keys (Generate strong random keys for production)
SECRET_KEY=your_production_secret_key_here
JWT_SECRET_KEY=your_production_jwt_secret_key_here
FERNET_KEY=your_32_byte_base64_fernet_encryption_key_here

# Database URI (Use PostgreSQL for Render production or SQLite for testing)
# Example PostgreSQL: postgresql://user:password@hostname:5432/cloudops_db
# Example SQLite: sqlite:///cloudops.db
DATABASE_URL=sqlite:///cloudops.db

# Frontend URL & Allowed CORS Origins (Comma-separated for multiple origins)
# Example: https://cloudoperations.onrender.com,http://localhost:5173
FRONTEND_URL=https://your-frontend-app.onrender.com
CORS_ORIGINS=https://your-frontend-app.onrender.com

# Default AWS Region
AWS_REGION=ap-south-1

# S3 Presigned URL Default Expiration (in seconds, e.g. 3600 = 1 hour)
S3_PRESIGNED_URL_EXPIRATION=3600
