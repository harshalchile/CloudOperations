# ==============================================================================
# Cloud Operations Center - Frontend Environment Configuration (.env.example)
# ==============================================================================

# API Base URL:
# - Leave empty (default) if frontend is served from the same domain/origin behind Nginx (e.g. EC2 reverse proxy with /api location).
# - Set full URL (e.g. http://localhost:5000/api or https://api.yourdomain.com/api) if backend is hosted on a separate host/port.
VITE_API_URL=

# WebSocket / Socket.IO URL:
# - Leave empty (default) if connecting to current browser origin (window.location.origin) proxied via Nginx (/socket.io/).
# - Set full URL (e.g. http://localhost:5000 or https://api.yourdomain.com) if WebSocket server is on a separate host/port.
VITE_WS_URL=
